          "default": null,
          "title": "Executable"
        },
        "ansvr_root": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ansvr Root"
        },
        "ansvr_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
