    "Gaia": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "allow_network": {
          "default": false,
          "title": "Allow Network",
          "type": "boolean"
        },
        "cache_dir": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
