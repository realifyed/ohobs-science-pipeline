        "attempts": {
          "default": 1,
          "maximum": 3,
          "minimum": 1,
          "title": "Attempts",
          "type": "integer"
        },
        "scale_min": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scale Min"
        },
        "scale_max": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scale Max"
        },
        "pointing_radius_deg": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 180,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pointing Radius Deg"
        },
        "max_rms_arcsec": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
