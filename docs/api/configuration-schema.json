          "title": "Detector Keys",
          "type": "array"
        },
        "optical_keys": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Optical Keys",
          "type": "array"
        }
      },
      "title": "Calibration",
      "type": "object"
    },
