        "min_frames": {
          "default": 5,
          "minimum": 3,
          "title": "Min Frames",
          "type": "integer"
        },
        "clip_sigma": {
          "default": 4,
          "exclusiveMinimum": 0,
          "title": "Clip Sigma",
          "type": "number"
        },
        "bootstrap_samples": {
          "default": 64,
          "minimum": 32,
          "title": "Bootstrap Samples",
          "type": "integer"
        },
        "flat_min_response": {
          "default": 0.1,
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Flat Min Response",
          "type": "number"
        },
        "flat_peak_code_fraction_max": {
          "anyOf": [
            {
              "exclusiveMaximum": 1,
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Flat Peak Code Fraction Max"
