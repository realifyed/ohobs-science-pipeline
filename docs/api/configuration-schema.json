      },
      "title": "Astrometry",
      "type": "object"
    },
    "Calibration": {
      "additionalProperties": false,
      "properties": {
        "bias_only_max_exposure_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bias Only Max Exposure S"
        },
        "bias_only_evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bias Only Evidence"
        },
        "temperature_tolerance_c": {
          "default": 0,
          "minimum": 0,
          "title": "Temperature Tolerance C",
          "type": "number"
        },
        "temperature_evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature Evidence"
