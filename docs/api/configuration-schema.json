        "max_image_mib": {
          "default": 48,
          "maximum": 128,
          "minimum": 1,
          "title": "Max Image Mib",
          "type": "integer"
        },
        "upload_mode": {
          "default": "source_list",
          "enum": [
            "source_list",
            "image",
            "image_fallback"
