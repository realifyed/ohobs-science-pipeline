          "default": null,
          "title": "Max Rms Arcsec"
        },
        "match_radius_arcsec": {
          "default": 5,
          "exclusiveMinimum": 0,
          "title": "Match Radius Arcsec",
          "type": "number"
        },
        "min_matches": {
          "default": 10,
          "minimum": 3,
          "title": "Min Matches",
          "type": "integer"
        },
        "min_match_fraction": {
          "default": 0.5,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Min Match Fraction",
          "type": "number"
