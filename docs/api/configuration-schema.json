        "timeout_s": {
          "default": 300,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Timeout S",
          "type": "number"
        },
        "request_timeout_s": {
          "default": 20,
          "exclusiveMinimum": 0,
          "maximum": 120,
          "title": "Request Timeout S",
          "type": "number"
